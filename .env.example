APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Dev auto-login (local only). Set APP_AUTO_LOGIN=true to skip the login page.
# APP_AUTO_LOGIN=false
# APP_USER_ROLE=admin   # admin | teacher | student

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# On Postgres/Supabase: keep app tables in a dedicated schema so migrations never touch the
# read-only history corpus in `public`. REQUIRED in production when DB_CONNECTION=pgsql.
# DB_SEARCH_PATH=app
# Optional: a SELECT-only role for the read-only corpus connection (falls back to DB_* above).
# CORPUS_DB_HOST=
# CORPUS_DB_DATABASE=
# CORPUS_DB_USERNAME=
# CORPUS_DB_PASSWORD=
#
# DEV SPEED: a remote (Supabase) app DB makes every Livewire round-trip ~1.5s connect + ~0.4s/query.
# For fast local dev, point DB_* at a LOCAL Postgres and keep the corpus remote via CORPUS_DB_*:
#   DB_HOST=127.0.0.1  DB_PORT=54329  DB_DATABASE=learningportal_dev  DB_USERNAME=postgres  DB_PASSWORD=postgres  DB_SSLMODE=prefer
#   CORPUS_DB_HOST=<supabase-pooler-host>  CORPUS_DB_USERNAME=<...>  CORPUS_DB_PASSWORD=<...>  (CORPUS_DB_PORT/DATABASE as needed)
# Then: create the DB + `app` schema, `php artisan migrate --seed`. In production keep the app DB
# co-located (same region) — connections pool per php-fpm worker so this latency disappears.
# Reuse connections across requests (helps prod php-fpm; default true):
# DB_PERSISTENT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# ── Local AI Services (development) ──────────────────────────────────────────
# Start all with: ./start-local.sh
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b


# ── Which model does which job ───────────────────────────────────────────────
# Roles, not vendors. "script" writes the narration a class actually hears; everything
# else — shot lists, quiz distractors, skybox prompts — is mechanical and can run on a
# free model. Value is a provider from config/llm.php, optionally provider:model.
# Check what's reachable and whether it answers in Dutch:  php artisan llm:probe
LLM_ROLE_SCRIPT=openai
LLM_ROLE_MECHANICAL=openai
LLM_ROLE_VISION=openai
LLM_DEFAULT_ROLE=mechanical

# Free / cheap providers, all OpenAI-compatible. Fill in a key to make one usable.
# Gemini's free tier serves Gemma; Groq is fast and free; DeepSeek is very cheap.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-3-27b-it
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Ollama needs no key. It rejects response_format, which is why its json_format is empty.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:12b

# ── Production AI APIs (leave blank in local dev) ────────────────────────────
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_SCENE_SIZE=1536x1024
OPENAI_SKYBOX_SIZE=1536x1024
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

ANTHROPIC_API_KEY=

ELEVENLABS_API_KEY=
POCKET_TTS_URL=
HF_TOKEN=

# ── Azure Speech Service (3D avatar lip sync) ────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ── Imagery policy ───────────────────────────────────────────────────────────
# Scene backgrounds come from the paintings corpus + Wikimedia Commons. Set to true only if you
# deliberately want to pay per generated image; every paid image job checks this.
AI_IMAGE_GENERATION=false

# Sourced backgrounds are resized to a Full HD stage and squeezed under the byte cap on download.
# Originals arrive at 3840px and 1.7-3 MB; a sixteen-scene lesson of those is tens of megabytes.
BACKGROUND_MAX_BYTES=100000
BACKGROUND_MAX_WIDTH=1920
BACKGROUND_MAX_HEIGHT=1080
BACKGROUND_START_QUALITY=60
BACKGROUND_ENCODER_SPEED=6
# AV1 film grain, drawn by the DECODER from ~100 bytes of parameters rather than baked into pixels.
# 1-16 are different grain MODELS, not a weak-to-strong dial (compare with
# scripts/test-avif-grain-presets.sh); 0 disables. Needs avifenc built with AOM, else it is ignored.
BACKGROUND_GRAIN_PRESET=1
AVIFENC_PATH=avifenc

# ── fal.ai (skybox image upscaler) ───────────────────────────────────────────
FAL_AI_KEY=
FAL_UPSCALE_ENABLED=true
FAL_UPSCALE_MODEL=fal-ai/clarity-upscaler
FAL_UPSCALE_FACTOR=2
FAL_ENHANCE_MODEL=fal-ai/clarity-upscaler
FAL_ENHANCE_FACTOR=4

# ── Upscayl local CLI (optional) ─────────────────────────────────────────────
UPSCAYL_ENABLED=false
UPSCAYL_BIN=/Applications/Upscayl.app/Contents/Resources/bin/upscayl-bin
UPSCAYL_MODEL_PATH=/Applications/Upscayl.app/Contents/Resources/models
UPSCAYL_MODEL=realesrgan-x4plus

# ── WorldLabs Marble (3D world generation) ────────────────────────────────────
WORLD_LABS_API_KEY=
WORLD_LABS_ENABLED=false

# ── Stripe (teachers buy narration credits) ──────────────────────────────────
# Hosted Checkout, so no card number ever reaches this server. Both values come from the Stripe
# dashboard and belong ONLY in .env: never in a commit, a test fixture or a chat message.
#
# Use test keys (sk_test_…) until the whole flow has been walked through end to end.
#   1. Secret key:    Developers > API keys
#   2. Webhook:       Developers > Webhooks > add endpoint https://<host>/stripe/webhook
#      Subscribe it to: checkout.session.completed, checkout.session.async_payment_succeeded,
#      charge.refunded, charge.dispute.created. The signing secret it shows is the one below.
#   3. Locally, `stripe listen --forward-to localhost:8000/stripe/webhook` prints its own secret.
#
# THREE separate values, and the webhook secret is not the secret key. The webhook one only exists
# once you have created the endpoint in step 2, so it is normal to have the other two first.
#
# Without STRIPE_WEBHOOK_SECRET the endpoint refuses every request with a 500: unverifiable and able
# to grant credit is a free credit machine for anyone who finds the URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Not used yet. Hosted Checkout is a redirect, so no Stripe.js runs on our pages.
STRIPE_PUBLISHABLE_KEY=

# Stripe Tax works the VAT out per country and reports the split back (0.5% per transaction).
# Turning it off means calculating and filing OSS by hand.
STRIPE_AUTOMATIC_TAX=true
# Let a school enter its VAT number, which reverse-charges the sale.
STRIPE_COLLECT_TAX_ID=true

# ── Narration credits ─────────────────────────────────────────────────────────
# What one pack is. The price is INCLUSIVE of VAT: the teacher pays exactly this and the tax comes
# out of it, which is what EU price-indication rules expect of a consumer-facing price.
NARRATION_CREDIT_CHARACTERS=5000
NARRATION_CREDIT_AMOUNT_CENTS=500
NARRATION_CREDIT_CURRENCY=eur
# How long bought credit lasts, in days. 0 switches expiry off entirely, and nothing a teacher
# paid for can then vanish. Prepaid credit that expires is regulated in several EU countries.
NARRATION_CREDIT_EXPIRY_DAYS=30

# ── Lesson settings ───────────────────────────────────────────────────────────
MAX_LESSON_GENERATION_ATTEMPTS=3


# ── Image search (lesson background slideshow) ────────────────────────────────
# Europeana: free API for European cultural heritage images (primary source)
# Register at: https://pro.europeana.eu/pages/get-api
EUROPEANA_API_KEY=

# Unsplash: photography archive (register at unsplash.com/developers)

# Pexels: photography archive (register at pexels.com/api)

# Wikimedia Commons is used as a no-key fallback — no configuration needed.

# fbx2gltf CLI binary path (install: https://github.com/facebookincubator/FBX2glTF)

# Temporary TTS provider override for lesson narration (e.g. azure). Blank = per-avatar (ElevenLabs).
TTS_PROVIDER_OVERRIDE=
TTS_PROVIDER_OVERRIDE_VOICE=
