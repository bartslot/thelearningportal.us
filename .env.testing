APP_ENV=testing
APP_KEY=base64:E/CNd1SRbRhmYLTslksfgqEvqOB+33wsode7bKNgDrQ=
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=learningportal_test
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SEARCH_PATH=app
DB_SSLMODE=disable
# Persistent PDO handles (prod default, for the Supabase pooler) are shared across PDO
# objects in one PHP process. Under phpunit the previous test's GC'd handle issues a raw
# ROLLBACK that kills RefreshDatabase's wrapper transaction mid-test ("SAVEPOINT can only
# be used in transaction blocks", 25P01) and forces a mid-suite re-migration. Never pool
# connections in the test process.
DB_PERSISTENT=false
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
